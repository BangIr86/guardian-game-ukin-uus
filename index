async function sendLKPDToSheets(){const c=config(),st=$("lkpdStatus");st.className="status no-print";st.textContent="Mengirim jawaban LKPD ke Google Sheets…";st.classList.remove("hidden");if(!c.endpoint||!c.endpoint.startsWith("https://script.google.com/")){st.classList.add("err");st.textContent="URL Web App belum diatur. Buka menu Pengaturan, masukkan URL Apps Script, lalu simpan.";return;}if(!c.consent){st.classList.add("err");st.textContent="Buka menu Pengaturan dan centang persetujuan pengiriman data terlebih dahulu.";return;}if(!$("lkpdName").value.trim()\vert{}\vert{}!$("lkpdClass").value.trim()){st.classList.add("err");st.textContent="Isi nama peserta didik dan kelas sebelum mengirim LKPD.";return;}saveConfig();saveLKPD(false);try{await fetch(c.endpoint,{method:"POST",mode:"no-cors",headers:{"Content-Type":"text/plain;charset=utf-8"},body:JSON.stringify(collectLKPD()),redirect:"follow"});st.className="status ok no-print";st.textContent="Permintaan pengiriman LKPD sudah dikirim. Karena koneksi no-cors tidak dapat membaca balasan server, periksa tab LKPD di Google Sheets untuk memastikan data masuk.";st.classList.remove("hidden");}catch(err){st.className="status err no-print";st.textContent="Pengiriman gagal: "+err.message+". Periksa koneksi internet dan URL Web App.";st.classList.remove("hidden");}}
function restore(){try{const d=JSON.parse(localStorage.getItem(storeKey)||"null");if(d){currentLevel=d.currentLevel||0;currentQ=d.currentQ||0;answers=d.answers||{};checked=d.checked||{};done=d.done||{};scoreByLevel=d.scoreByLevel||Array(6).fill(0);started=!!d.started;$("teamName").value=d.teamName\vert{}\vert{}"";$("className").value=d.className||"";$("members").value=d.members\vert{}\vert{}"";$("reflection1").value=d.reflection1||"";$("reflection2").value=d.reflection2\vert{}\vert{}"";$("reflection3").value=d.reflection3||""}}catch(e){}try{const c=JSON.parse(localStorage.getItem(configKey)||"{}");$("endpoint").value=c.endpoint||"";$("teacherCode").value=c.teacherCode\vert{}\vert{}"";$("consentCheck").checked=!!c.consent}catch(e){}updateStats()}
