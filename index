async function sendData(test=false){const c=config(),status=test?$("settingsStatus"):$("saveStatus");status.className="status";status.textContent="Mengirim data…";status.classList.remove("hidden");if(!c.endpoint||!c.endpoint.startsWith("https://script.google.com/")){status.classList.add("err");status.textContent="Masukkan URL Web App Google Apps Script yang valid (berawalan https://script.google.com/).";return}if(!c.consent){status.classList.add("err");status.textContent="Centang konfirmasi privasi terlebih dahulu pada Pengaturan.";return}if(!test&&(!$("teamName").value.trim()\vert{}\vert{}!$("className").value.trim())){status.classList.add("err");status.textContent="Isi nama kelompok dan kelas pada Beranda terlebih dahulu.";return}saveConfig();const data=payload(test);try{
 // no-cors is used because Apps Script Web Apps may not expose CORS headers to a local HTML file.
