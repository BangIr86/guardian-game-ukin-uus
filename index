if(checked[key])html+=`<div class="feedback ${selected===q.c?"good":"bad"}"><b>${selected===q.c?"✅ Tepat!":"💡 Mari pelajari kembali."}</b><br>${q.e}<br><span class="small">Jawaban benar: ${String.fromCharCode(65+q.c)}. ${q.a[q.c]}</span></div>`;
html+="</div>";$("questionHost").innerHTML=html;
document.querySelectorAll("[data-answer]").forEach(b=>b.addEventListener("click",()=>{const k=currentLevel+"-"+currentQ;if(checked[k])return;answers[k]=Number(b.dataset.answer);saveLocal();renderQuestion()}));
$("prevBtn").disabled=currentQ===0;$("nextBtn").textContent=currentQ===l.questions.length-1?(currentLevel===5?"Selesaikan →":"Level Berikutnya →"):"Soal Berikutnya →";$("checkBtn").disabled=!!checked[key];$("checkBtn").textContent=checked[key]?"Sudah Diperiksa":"Periksa Jawaban";updateStats()}
function checkAnswer(){const key=currentLevel+"-"+currentQ;if(answers[key]===undefined){alert("Pilih salah satu jawaban terlebih dahulu.");return}if(checked[key])return;checked[key]=true;const q=levels[currentLevel].questions[currentQ];if(answers[key]===q.c)scoreByLevel[currentLevel]+=10;if(levels[currentLevel].questions.every((_,i)=>checked[currentLevel+"-"+i]))done[currentLevel]=true;saveLocal();renderQuestion()}
function next(){const l=levels[currentLevel];if(!checked[currentLevel+"-"+currentQ]){alert("Periksa jawaban sebelum melanjutkan agar pembahasan muncul.");return}if(currentQ<l.questions.length-1){currentQ++;renderQuestion()}else{done[currentLevel]=true;saveLocal();if(currentLevel<5){if(confirm("Level selesai! Lanjut ke level berikutnya?"))openLevel(currentLevel+1);else showScreen("intro")}else showScreen("results")}}
