<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Digital Guardian — Informatika Kelas IX</title>
<style>
:root{--blue:#174d91;--blue2:#d9efff;--pink:#ff5d9e;--pink2:#ffe0ec;--yellow:#ffd85b;--yellow2:#fff4c4;--green:#2b9b62;--green2:#dcf8e6;--ink:#17324d;--muted:#5f7184;--paper:#fff;--line:#dce7f0;--shadow:0 12px 32px #16436c12}
*{box-sizing:border-box}body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;color:var(--ink);background:linear-gradient(135deg,#eef8ff,#fff3f8 50%,#fffbe5);min-height:100vh}
button,input,textarea,select{font:inherit}button{cursor:pointer;border:0;border-radius:13px;padding:11px 16px;font-weight:750;transition:.15s}button:hover{transform:translateY(-1px);filter:brightness(.98)}button:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid #3289df;outline-offset:2px}
.primary{background:var(--blue);color:#fff}.pinkbtn{background:var(--pink);color:white}.greenbtn{background:var(--green);color:white}.yellowbtn{background:var(--yellow);color:#493700}.secondary{background:#edf4fa;color:var(--blue);border:1px solid var(--line)}.danger{background:#ffe5e5;color:#a52132}
.wrap{max-width:1100px;margin:auto;padding:20px}.hero{background:linear-gradient(120deg,#174d91,#247fbd);color:#fff;border-radius:24px;padding:26px;box-shadow:var(--shadow);position:relative;overflow:hidden}.hero:after{content:"🛡️";font-size:100px;position:absolute;right:22px;top:10px;opacity:.22}.eyebrow{font-weight:800;text-transform:uppercase;letter-spacing:.1em;font-size:.75rem;color:#ffdf6a}.hero h1{font-size:clamp(2rem,5vw,3.3rem);line-height:1.05;margin:8px 0}.hero p{max-width:690px;margin-bottom:0;color:#e6f5ff}
.layout{display:grid;grid-template-columns:260px 1fr;gap:18px;margin-top:18px}.panel,.card{background:var(--paper);border:1px solid var(--line);border-radius:20px;padding:18px;box-shadow:var(--shadow)}.side h2{margin:0 0 12px;font-size:1.1rem}.stats{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.stat{background:#f4f9fd;border-radius:13px;padding:12px}.stat strong{display:block;font-size:1.4rem;color:var(--blue)}.stat span{font-size:.78rem;color:var(--muted)}.levelnav{display:grid;gap:8px;margin-top:15px}.levelnav button{text-align:left;background:#f5f8fb;color:var(--ink);border:1px solid transparent;padding:11px}.levelnav button.active{background:var(--blue2);border-color:#8cc9f2;color:#124c88}.levelnav button.done{background:var(--green2)}.levelnav small{display:block;font-weight:500;color:var(--muted);margin-top:2px}
.content{min-width:0}.topline{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}.pill{display:inline-flex;align-items:center;gap:6px;padding:6px 10px;border-radius:999px;background:var(--yellow2);font-size:.82rem;font-weight:800}.progress{height:10px;border-radius:99px;background:#eaf0f5;overflow:hidden;margin:12px 0 18px}.progress div{height:100%;width:0;background:linear-gradient(90deg,var(--pink),var(--yellow),var(--green));transition:width .25s}.screen{display:none}.screen.active{display:block}.section-title{margin:0 0 8px;font-size:1.55rem}.muted{color:var(--muted)}.field{display:grid;gap:6px;margin:12px 0}.field label{font-weight:750;font-size:.92rem}.field input,.field textarea,.field select{width:100%;padding:12px;border:1px solid #cbd9e5;border-radius:12px;background:#fff;color:var(--ink)}.field textarea{min-height:90px;resize:vertical}.two{display:grid;grid-template-columns:1fr 1fr;gap:12px}.welcome-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:18px 0}.feature{padding:14px;border-radius:15px}.feature:nth-child(1){background:var(--yellow2)}.feature:nth-child(2){background:var(--pink2)}.feature:nth-child(3){background:var(--green2)}.feature b{display:block;margin:5px 0}.question{border:1px solid var(--line);border-radius:17px;padding:18px;margin:14px 0;background:#fff}.qmeta{font-size:.8rem;color:var(--muted);font-weight:750}.qtext{font-size:1.1rem;font-weight:800;margin:10px 0 14px}.answers{display:grid;gap:9px}.answer{display:flex;gap:10px;align-items:flex-start;text-align:left;background:#f7fafc;border:1px solid #dce7f0;color:var(--ink);padding:12px;border-radius:12px;font-weight:600}.answer .letter{flex:0 0 27px;height:27px;border-radius:8px;display:grid;place-items:center;background:var(--blue2);color:var(--blue);font-weight:900}.answer.selected{border-color:var(--blue);background:#e9f5ff}.answer.correct{border-color:var(--green);background:var(--green2)}.answer.wrong{border-color:#f06477;background:#fff0f1}.feedback{padding:12px 14px;border-radius:12px;margin-top:12px;background:#f0f7ff;border-left:4px solid var(--blue)}.feedback.good{background:var(--green2);border-color:var(--green)}.feedback.bad{background:#fff0f1;border-color:#e34c63}.actions{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-top:18px}.actions .right{display:flex;gap:8px;flex-wrap:wrap}.notice{padding:12px;border-radius:12px;background:var(--yellow2);font-size:.9rem}.hidden{display:none!important}.badgebox{display:flex;gap:12px;align-items:center;background:linear-gradient(120deg,var(--yellow2),var(--pink2));padding:18px;border-radius:18px}.badgeicon{font-size:2.5rem}.resultgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.result{padding:14px;border-radius:14px;background:#f5f9fc}.result strong{font-size:1.4rem;display:block}.footer{text-align:center;color:var(--muted);font-size:.85rem;padding:22px}.small{font-size:.82rem}.checkline{display:flex;gap:8px;align-items:flex-start;margin:10px 0}.checkline input{margin-top:5px}.status{font-size:.88rem;padding:10px 12px;border-radius:10px;background:#eef6ff;color:#1a5389;word-break:break-word}.status.ok{background:var(--green2);color:#17633b}.status.err{background:#fff0f1;color:#a52132}
@media(max-width:800px){.layout{grid-template-columns:1fr}.side{order:2}.content{order:1}.levelnav{grid-template-columns:repeat(2,1fr)}.welcome-grid,.resultgrid{grid-template-columns:1fr}.hero:after{font-size:65px;right:8px}.wrap{padding:12px}.hero{padding:22px 18px}.two{grid-template-columns:1fr}}
.lkpd-table{width:100%;border-collapse:collapse;margin:12px 0;font-size:.92rem}.lkpd-table th,.lkpd-table td{border:1px solid #cbd9e5;padding:9px;text-align:left;vertical-align:top}.lkpd-table th{background:#eaf5ff}.lkpd-table textarea{width:100%;min-width:100px;min-height:75px;border:1px solid #cbd9e5;border-radius:8px;padding:8px;font:inherit;resize:vertical}.lkpd-activity{border:1px solid var(--line);border-radius:16px;padding:16px;margin:16px 0;background:#fff}.lkpd-activity h3{margin-top:0}.lkpd-question{padding:12px;border-radius:12px;background:#f6faff;margin:10px 0}.lkpd-question label{display:block;font-weight:750;margin-bottom:6px}.lkpd-question textarea{width:100%;min-height:85px;border:1px solid #cbd9e5;border-radius:10px;padding:10px;font:inherit}.lkpd-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}
@media print{
  @page{size:A4;margin:15mm}
  body{background:#fff!important;color:#111!important}
  body *{visibility:hidden!important}
  #screen-lkpd.active,#screen-lkpd.active *{visibility:visible!important}
  #screen-lkpd.active{display:block!important;position:absolute!important;left:0!important;top:0!important;width:100%!important;border:0!important;box-shadow:none!important;padding:0!important;margin:0!important}
  #screen-lkpd .lkpd-actions,#screen-lkpd .no-print{display:none!important}
  #screen-lkpd .field input,#screen-lkpd textarea{border:1px solid #777!important;color:#111!important;background:#fff!important}
  #screen-lkpd .lkpd-activity{break-inside:avoid;border:1px solid #777;box-shadow:none}
  #screen-lkpd .lkpd-table th{background:#eee!important}
}
</style>
</head>
<body>
<div class="wrap">
<header class="hero">
  <div class="eyebrow">Informatika • Kelas IX • Bab IV</div>
  <h1>🛡️ Digital Guardian</h1>
  <p>Misi menjaga dunia digital: berpikir sebelum berbagi, berempati saat berinteraksi, dan melindungi data pribadi. Selesaikan enam level bersama timmu!</p>
</header>

<div class="layout">
<aside class="panel side">
  <h2>📍 Peta Misi</h2>
  <div class="stats">
    <div class="stat"><strong id="sideScore">0</strong><span>Total poin</span></div>
    <div class="stat"><strong id="sideDone">0/6</strong><span>Level selesai</span></div>
  </div>
  <div class="progress"><div id="overallBar"></div></div>
  <nav class="levelnav" id="levelNav">
    <button data-screen="intro" class="active">🏠 Beranda <small>Persiapan tim</small></button>
    <button data-screen="lkpd">📘 LKPD <small>Lembar kerja peserta didik</small></button>
    <button data-level="0">🔎 Level 1 <small>Detektif Perilaku</small></button>
    <button data-level="1">💥 Level 2 <small>Dampak Digital</small></button>
    <button data-level="2">💗 Level 3 <small>Empati Digital</small></button>
    <button data-level="3">🧘 Level 4 <small>Mindfulness</small></button>
    <button data-level="4">🔐 Level 5 <small>Pelindung Data</small></button>
    <button data-level="5">🌱 Level 6 <small>Refleksi Diri</small></button>
    <button data-screen="results">🏆 Evaluasi Akhir <small>Hasil tim</small></button>
    <button data-screen="settings">⚙️ Pengaturan <small>Google Sheets</small></button>
  </nav>
  <p class="small muted">Tip: diskusikan jawaban bersama anggota kelompok sebelum memilih.</p>
</aside>

<main class="content">
<section id="screen-intro" class="screen active card">
  <span class="pill">🎮 Misi dimulai di sini</span>
  <h2 class="section-title">Selamat datang, Guardian!</h2>
  <p class="muted">Isi identitas kelompok, lalu jalankan enam misi. Setiap soal memiliki umpan balik dan pembahasan. Jawaban dinilai untuk pembelajaran, bukan untuk menghakimi kebiasaan pribadi.</p>
  <details style="margin:14px 0;padding:12px 14px;border:1px solid var(--line);border-radius:14px;background:#f8fbff">
    <summary style="font-weight:800;cursor:pointer">Lihat enam tujuan pembelajaran</summary>
    <ol>
      <li>Mengidentifikasi perilaku positif dan negatif dalam berinteraksi di dunia digital.</li>
      <li>Menjelaskan dampak perilaku digital, seperti cyberbullying, oversharing, kecanduan digital, dan penyebaran hoaks.</li>
      <li>Menganalisis perilaku digital berdasarkan prinsip toleransi, empati, dan tanggung jawab.</li>
      <li>Menerapkan prinsip mindfulness sebelum membuat, membagikan, atau menanggapi konten digital.</li>
      <li>Menentukan langkah-langkah untuk melindungi data pribadi dan identitas digital.</li>
      <li>Mengevaluasi perilaku diri sendiri dalam menggunakan teknologi digital serta merumuskan tindakan untuk membangun kebiasaan digital yang aman dan bijak.</li>
    </ol>
  </details>
  <div class="two">
    <div class="field"><label for="teamName">Nama kelompok *</label><input id="teamName" placeholder="Contoh: Tim Cyber Cerdas" maxlength="80"></div>
    <div class="field"><label for="className">Kelas *</label><input id="className" placeholder="Contoh: IX-A" maxlength="30"></div>
  </div>
  <div class="field"><label for="members">Nama anggota (pisahkan dengan koma)</label><input id="members" placeholder="Alya, Bima, Citra" maxlength="300"></div>
  <div class="welcome-grid">
    <div class="feature">🧠<b>Berpikir kritis</b><span class="small">Analisis situasi nyata di dunia digital.</span></div>
    <div class="feature">💬<b>Diskusi tim</b><span class="small">Dengarkan pendapat dan ambil keputusan bersama.</span></div>
    <div class="feature">🛡️<b>Jadi pelindung</b><span class="small">Pilih tindakan yang aman dan bertanggung jawab.</span></div>
  </div>
  <div class="notice">Aturan: jangan masukkan kata sandi, nomor identitas, alamat rumah, atau data pribadi sensitif ke dalam game.</div>
  <div class="actions"><span></span><button class="primary" id="startBtn">Mulai Misi 1 →</button></div>
</section>

<section id="screen-lkpd" class="screen card">
  <span class="pill">📘 Lembar Kerja Peserta Didik</span>
  <h2 class="section-title">LKPD: Etika, Empati, dan Keamanan Digital</h2>
  <p class="muted">Mata Pelajaran: Informatika • Kelas IX SMP/MTs • Media: Digital Guardian</p>
  <div class="notice no-print">Isi LKPD ini berdasarkan diskusi dan kegiatan pada Digital Guardian. Jawaban disimpan di browser perangkat ini dan tidak dikirim ke internet secara otomatis.</div>
  <h3>Identitas Peserta Didik</h3>
  <div class="two">
    <div class="field"><label for="lkpdName">Nama peserta didik</label><input id="lkpdName" maxlength="100" placeholder="Nama lengkap"></div>
    <div class="field"><label for="lkpdClass">Kelas</label><input id="lkpdClass" maxlength="30" placeholder="Contoh: IX-A"></div>
    <div class="field"><label for="lkpdGroup">Nama kelompok</label><input id="lkpdGroup" maxlength="80" placeholder="Nama kelompok"></div>
    <div class="field"><label for="lkpdDate">Tanggal pengerjaan</label><input id="lkpdDate" type="date"></div>
  </div>
  <div class="field"><label for="lkpdMembers">Nama anggota kelompok</label><textarea id="lkpdMembers" maxlength="500" placeholder="Tuliskan nama anggota kelompok"></textarea></div>
  <div class="lkpd-activity">
    <h3>Tujuan Pembelajaran</h3>
    <ol>
      <li>Mengidentifikasi perilaku positif dan negatif dalam interaksi digital.</li>
      <li>Menganalisis dampak cyberbullying, hoaks, oversharing, dan penggunaan teknologi berlebihan.</li>
    </ol>
  </div>
  <div class="lkpd-activity">
    <h3>Aktivitas 1 – Identifikasi Perilaku Digital</h3>
    <p class="muted">Tuliskan contoh situasi digital, klasifikasikan perilakunya, lalu jelaskan alasan dan tindakan yang tepat.</p>
    <table class="lkpd-table"><thead><tr><th>Situasi/contoh perilaku digital</th><th>Positif atau negatif</th><th>Alasan</th><th>Tindakan yang seharusnya</th></tr></thead><tbody>
      <tr><td><textarea id="lkpdA1s1" aria-label="Situasi 1"></textarea></td><td><textarea id="lkpdA1p1" aria-label="Klasifikasi 1"></textarea></td><td><textarea id="lkpdA1a1" aria-label="Alasan 1"></textarea></td><td><textarea id="lkpdA1t1" aria-label="Tindakan 1"></textarea></td></tr>
      <tr><td><textarea id="lkpdA1s2" aria-label="Situasi 2"></textarea></td><td><textarea id="lkpdA1p2" aria-label="Klasifikasi 2"></textarea></td><td><textarea id="lkpdA1a2" aria-label="Alasan 2"></textarea></td><td><textarea id="lkpdA1t2" aria-label="Tindakan 2"></textarea></td></tr>
      <tr><td><textarea id="lkpdA1s3" aria-label="Situasi 3"></textarea></td><td><textarea id="lkpdA1p3" aria-label="Klasifikasi 3"></textarea></td><td><textarea id="lkpdA1a3" aria-label="Alasan 3"></textarea></td><td><textarea id="lkpdA1t3" aria-label="Tindakan 3"></textarea></td></tr>
    </tbody></table>
  </div>
  <div class="lkpd-activity">
    <h3>Aktivitas 2 – Analisis Kasus</h3>
    <div class="lkpd-question"><b>Kasus A: Cyberbullying di grup kelas</b><p>Seorang peserta didik terus-menerus diejek di grup kelas. Analisis masalah, dampaknya, dan tindakan yang bertanggung jawab.</p><label for="lkpdA2a">Jawaban</label><textarea id="lkpdA2a" placeholder="Masalah, dampak, dan solusi..."></textarea></div>
    <div class="lkpd-question"><b>Kasus B: Berita yang belum terverifikasi</b><p>Kamu menerima berita mengejutkan tanpa sumber yang jelas. Apa yang perlu diperiksa sebelum membagikannya?</p><label for="lkpdA2b">Jawaban</label><textarea id="lkpdA2b" placeholder="Langkah pemeriksaan fakta..."></textarea></div>
    <div class="lkpd-question"><b>Kasus C: Data pribadi di media sosial</b><p>Seorang teman mengunggah foto kartu identitas dan alamat rumah secara publik. Apa risikonya dan bagaimana mencegahnya?</p><label for="lkpdA2c">Jawaban</label><textarea id="lkpdA2c" placeholder="Risiko dan langkah perlindungan..."></textarea></div>
  </div>
  <div class="lkpd-activity">
    <h3>Aktivitas 3 – Empati dan Mindfulness Digital</h3>
    <div class="lkpd-question"><label for="lkpdA3a">1. Apa yang akan kamu lakukan ketika melihat teman menjadi sasaran ejekan daring?</label><textarea id="lkpdA3a"></textarea></div>
    <div class="lkpd-question"><label for="lkpdA3b">2. Bagaimana kamu merespons ketika menerima komentar yang membuat marah?</label><textarea id="lkpdA3b"></textarea></div>
    <div class="lkpd-question"><label for="lkpdA3c">3. Apa yang perlu dipertimbangkan sebelum mengunggah foto atau video teman?</label><textarea id="lkpdA3c"></textarea></div>
  </div>
  <div class="lkpd-activity">
    <h3>Aktivitas 4 – Perlindungan Data Pribadi</h3>
    <p class="muted">Jangan tuliskan kata sandi, kode OTP, atau data rahasia milikmu. Analisis contoh situasi berikut.</p>
    <table class="lkpd-table"><thead><tr><th>Informasi/situasi</th><th>Risiko yang mungkin terjadi</th><th>Langkah perlindungan</th></tr></thead><tbody>
      <tr><td>Kata sandi dan kode OTP</td><td><textarea id="lkpdA4r1" aria-label="Risiko kata sandi dan OTP"></textarea></td><td><textarea id="lkpdA4p1" aria-label="Perlindungan kata sandi dan OTP"></textarea></td></tr>
      <tr><td>Alamat rumah dan rutinitas harian</td><td><textarea id="lkpdA4r2" aria-label="Risiko alamat rumah"></textarea></td><td><textarea id="lkpdA4p2" aria-label="Perlindungan alamat rumah"></textarea></td></tr>
      <tr><td>Tautan hadiah yang mencurigakan</td><td><textarea id="lkpdA4r3" aria-label="Risiko tautan mencurigakan"></textarea></td><td><textarea id="lkpdA4p3" aria-label="Perlindungan tautan mencurigakan"></textarea></td></tr>
      <tr><td>Informasi akun dan profil publik</td><td><textarea id="lkpdA4r4" aria-label="Risiko informasi akun"></textarea></td><td><textarea id="lkpdA4p4" aria-label="Perlindungan informasi akun"></textarea></td></tr>
    </tbody></table>
  </div>
  <div class="lkpd-activity">
    <h3>Aktivitas 5 – Refleksi dan Komitmen Digital</h3>
    <div class="lkpd-question"><label for="lkpdA5a">1. Apa hal baru yang saya pelajari?</label><textarea id="lkpdA5a"></textarea></div>
    <div class="lkpd-question"><label for="lkpdA5b">2. Kebiasaan digital apa yang perlu saya perbaiki?</label><textarea id="lkpdA5b"></textarea></div>
    <div class="lkpd-question"><label for="lkpdA5c">3. Bagaimana cara saya menunjukkan empati di dunia digital?</label><textarea id="lkpdA5c"></textarea></div>
    <div class="lkpd-question"><label for="lkpdA5d">4. Tuliskan tiga tindakan nyata untuk menjaga keamanan digital.</label><textarea id="lkpdA5d"></textarea></div>
  </div>
  <div id="lkpdStatus" class="status hidden no-print" role="status" aria-live="polite"></div>
  <div class="lkpd-actions no-print">
    <button class="greenbtn" id="lkpdSaveBtn">💾 Simpan Jawaban</button>
    <button class="primary" id="lkpdSendBtn">☁️ Kirim LKPD ke Google Sheets</button>
    <button class="secondary" id="lkpdLoadBtn">↻ Muat Kembali Jawaban</button>
    <button class="danger" id="lkpdClearBtn">Kosongkan LKPD</button>
    <button class="primary" id="lkpdPrintBtn">🖨️ Cetak / Simpan PDF</button>
    <button class="secondary" id="lkpdHomeBtn">← Kembali ke Beranda</button>
  </div>
</section>

<section id="screen-level" class="screen card">
  <div class="topline"><span class="pill" id="levelPill">LEVEL 1</span><span class="muted small" id="qCounter">Soal 1 dari 3</span></div>
  <h2 class="section-title" id="levelTitle">Detektif Perilaku Digital</h2>
  <p class="muted" id="levelDesc"></p>
  <div class="progress"><div id="levelBar"></div></div>
  <div id="questionHost"></div>
  <div class="actions">
    <button class="secondary" id="prevBtn">← Sebelumnya</button>
    <div class="right"><button class="secondary" id="checkBtn">Periksa Jawaban</button><button class="primary" id="nextBtn">Soal Berikutnya →</button></div>
  </div>
</section>

<section id="screen-results" class="screen card">
  <span class="pill">🏆 Evaluasi Akhir</span>
  <h2 class="section-title">Laporan Misi Tim</h2>
  <p class="muted">Tinjau hasil kelompok, lalu isi refleksi dan kirim rekap ke Google Sheets bila sudah dikonfigurasi.</p>
  <div class="badgebox"><div class="badgeicon" id="resultIcon">🛡️</div><div><h3 id="resultRank" style="margin:0 0 4px">Guardian Pemula</h3><div id="resultMessage">Selesaikan misi untuk melihat hasil.</div></div></div>
  <div class="resultgrid" style="margin-top:14px">
    <div class="result"><span class="muted small">Skor</span><strong id="finalScore">0/180</strong></div>
    <div class="result"><span class="muted small">Akurasi</span><strong id="accuracy">0%</strong></div>
    <div class="result"><span class="muted small">Level selesai</span><strong id="finishedLevels">0/6</strong></div>
  </div>
  <h3>Skor per misi</h3><div id="levelResults"></div>
  <h3>🌱 Refleksi dan komitmen kelompok</h3>
  <div class="field"><label for="reflection1">Kebiasaan digital apa yang perlu kami perbaiki?</label><textarea id="reflection1" maxlength="1000" placeholder="Tuliskan hasil diskusi kelompok..."></textarea></div>
  <div class="field"><label for="reflection2">Langkah nyata apa yang akan kami lakukan mulai hari ini?</label><textarea id="reflection2" maxlength="1000" placeholder="Contoh: memeriksa sumber berita sebelum membagikannya..."></textarea></div>
  <div class="field"><label for="reflection3">Bagaimana kelompok akan saling mengingatkan dengan empati?</label><textarea id="reflection3" maxlength="1000" placeholder="Tuliskan kesepakatan tim..."></textarea></div>
  <div class="actions"><button class="secondary" id="reviewBtn">← Tinjau Misi</button><div class="right"><button class="greenbtn" id="saveBtn">☁️ Kirim Hasil ke Google Sheets</button><button class="primary" id="printBtn">Cetak / Simpan PDF</button></div></div>
  <div id="saveStatus" class="status hidden" role="status" aria-live="polite"></div>
</section>

<section id="screen-settings" class="screen card">
  <span class="pill">⚙️ Pengaturan Guru</span>
  <h2 class="section-title">Hubungkan Google Sheets</h2>
