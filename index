function updateStats(){ $("sideScore").textContent=totalScore();$("sideDone").textContent=Object.keys(done).length+"/6";$("overallBar").style.width=(Object.keys(done).length/6*100)+"%";document.querySelectorAll("[data-level]").forEach(b=>{const i=Number(b.dataset.level);b.classList.toggle("done",!!done[i]);b.innerHTML=`${["🔎","💥","💗","🧘","🔐","🌱"][i]} Level ${i+1}<small>${levels[i].title}${done[i]?" · ✓":""}</small>`})}
