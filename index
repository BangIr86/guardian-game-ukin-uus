 await fetch(c.endpoint,{method:"POST",mode:"no-cors",headers:{"Content-Type":"text/plain;charset=utf-8"},body:JSON.stringify(data),redirect:"follow"});
 status.className="status ok";status.textContent="Permintaan pengiriman sudah dikirim oleh browser. Mode no-cors tidak memungkinkan game membaca konfirmasi server; periksa tab Google Sheets untuk memastikan baris masuk. Jika belum muncul, cek deployment Apps Script dan akses Web App.";
 }catch(err){status.className="status err";status.textContent="Pengiriman gagal dari browser: "+err.message+". Periksa koneksi internet, URL deployment, dan izin akses Web App."}}
