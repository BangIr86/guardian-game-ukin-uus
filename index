function renderResults(){const score=totalScore(),max=180,answered=totalAnswered(),correct=score/10;$("finalScore").textContent=score+"/"+max;$("accuracy").textContent=Math.round(correct/18*100)+"\%";$("finishedLevels").textContent=Object.keys(done).length+"/6";let rank=score>=160?["🌟","Guardian Teladan","Hebat! Tim menunjukkan pemahaman yang sangat kuat."]:score>=120?["🛡️","Guardian Andal","Bagus! Terus praktikkan kebiasaan digital yang aman."]:score>=70?["🌱","Guardian Bertumbuh","Kalian sedang berkembang. Tinjau pembahasan dan coba lagi."]:["💡","Guardian Pemula","Jadikan setiap pembahasan sebagai kesempatan belajar."];$("resultIcon").textContent=rank[0];$("resultRank").textContent=rank[1];$("resultMessage").textContent=rank[2];$("levelResults").innerHTML=levels.map((l,i)=>`<div class="result" style="margin:8px 0"><div style="display:flex;justify-content:space-between;gap:10px"><b>${i+1}. ${l.title}</b><strong>${scoreByLevel[i]}/30</strong></div><div class="progress"><div style="width:${scoreByLevel[i]/30*100}%"></div></div><span class="small muted">${done[i]?"Level selesai":"Belum semua soal diperiksa"}</span></div>`).join("")}
